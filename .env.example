# Copy to .env and edit before `docker compose up`.

# ---- required --------------------------------------------------------------
# Shared secret between smoke-agent and smoke-server.
# Generate one with:  docker compose run --rm smoke-server genkey
SMOKE_API_KEY=change-me-to-a-long-random-string

# ---- agent identity --------------------------------------------------------
SMOKE_AGENT_ID=compose-agent-01
# The vantage point label. Every dashboard groups by this, so make it mean
# something: "seoul-idc", "aws-ap-northeast-2", "office-wifi".
SMOKE_AGENT_LOCATION=docker-local

# ---- storage ---------------------------------------------------------------
# clickhouse | postgresql
SMOKE_STORAGE_DRIVER=clickhouse
SMOKE_RETENTION_DAYS=90

CLICKHOUSE_PASSWORD=

POSTGRES_USER=smoke
POSTGRES_PASSWORD=smoke
POSTGRES_DB=smokeping

# ---- ports and logging -----------------------------------------------------
SMOKE_SERVER_PORT=8080
GRAFANA_PORT=3000
GRAFANA_PASSWORD=admin
SMOKE_LOG_LEVEL=INFO
